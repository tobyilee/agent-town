{
  "name": "agent-town",
  "version": "0.1.0",
  "description": "A Gather.town-style office where your AI coding agents (Claude Code, Codex) work as animated pixel characters.",
  "type": "module",
  "private": true,
  "bin": {
    "agent-town": "server/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "demo": "node server/index.js --demo",
    "sprites": "node scripts/gen-placeholder-sprites.js",
    "sprites:codex": "bash scripts/gen-sprites-codex.sh",
    "test": "node --test test/*.test.js",
    "sprites:check": "node scripts/check-sprites.js"
  },
  "license": "MIT"
}
