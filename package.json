{
  "name": "agent-town",
  "version": "0.1.0",
  "description": "A Gather.town / ZEP-style virtual office where your AI coding agents (Claude Code, Codex) work as animated characters.",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobyilee/agent-town.git"
  },
  "homepage": "https://github.com/tobyilee/agent-town#readme",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "virtual-office",
    "gather-town",
    "visualization"
  ],
  "bin": {
    "agent-town": "server/index.js",
    "agent-town-client": "sync/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "demo": "node server/index.js --demo",
    "client": "node sync/index.js",
    "client:demo": "node sync/index.js --demo",
    "cloud:dev": "npm --prefix cloud run dev",
    "cloud:deploy": "npm --prefix cloud run deploy",
    "test": "node --test test/*.test.js",
    "sprites:codex": "node scripts/gen-sprites-codex.js",
    "sprites:fit": "node scripts/gen-sprites-codex.js --fit",
    "sprites:check": "node scripts/check-sprites.js"
  },
  "license": "MIT"
}
